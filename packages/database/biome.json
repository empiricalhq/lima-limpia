{
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "performance": {
        "recommended": true,
        "noReExportAll": "off",
        "noBarrelFile": "off"
      },
      "security": {
        "recommended": true,
        "noSecrets": "off"
      },
      "style": {
        "recommended": true,
        "noJsxLiterals": "off",
        "noTernary": "off",
        "useExportsLast": "off"
      }
    }
  }
}
