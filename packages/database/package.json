{
  "name": "@lima-garbage/database",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./testing/database.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts && biome format --write ./migrations",
    "db:push": "bun --env-file=../../.env drizzle-kit push --config ./drizzle.config.ts --force",
    "setup:municipality": "bun --env-file=../../.env scripts/create-municipality.ts",
    "setup:support": "bun --env-file=../../.env scripts/create-support.ts",
    "db:seed": "bun --env-file=../../.env scripts/seed.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "bun test --timeout 60000 scripts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "better-auth": "~1.7.7",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@paralleldrive/cuid2": "^3.3.0",
    "@types/bun": "1.4.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "7.0.2"
  }
}
