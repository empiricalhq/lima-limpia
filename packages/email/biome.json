{
  "root": false,
  "extends": "//",
  "linter": {
    "domains": {
      "next": "all",
      "solid": "none"
    },
    "rules": {
      "style": {
        "recommended": true,
        "noDefaultExport": "off",
        "noJsxLiterals": "off",
        "noTernary": "off",
        "useExportsLast": "off"
      },
      "security": {
        "noSecrets": "off"
      }
    }
  }
}
