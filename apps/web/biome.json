{
  "root": false,
  "extends": "//",
  "linter": {
    "domains": {
      "next": "all",
      "solid": "none"
    },
    "rules": {
      "security": {
        "preset": "recommended",
        "noSecrets": "off"
      },
      "style": {
        "preset": "recommended",
        "noDefaultExport": "off",
        "useComponentExportOnlyModules": "off",
        "noProcessEnv": "off",
        "useNamingConvention": "off",
        "noJsxLiterals": "off",
        "noTernary": "off",
        "useExportsLast": "off"
      },
      "suspicious": {
        "preset": "recommended",
        "noUnknownAtRules": "off"
      },
      "performance": {
        "preset": "recommended",
        "noNamespaceImport": "off",
        "noJsxPropsBind": "off"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
