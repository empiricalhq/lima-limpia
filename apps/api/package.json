{
  "name": "@lima-garbage/api",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "bun build src/cmd/server.ts --target=node --outdir=dist --minify --external hono --external better-auth --external resend --external zod --external pg",
    "build:worker": "bun build src/cmd/server.ts --target=bun --outdir=dist --minify --external hono --external better-auth --external resend --external zod --external pg",
    "deploy": "wrangler deploy",
    "dev": "bun --hot --env-file=../../.env src/cmd/server.ts",
    "start": "bun src/cmd/server.ts",
    "test": "bun test-runner.ts",
    "test:dev": "bun --hot --env-file=../../.env.test src/cmd/server.ts",
    "format": "biome format --write .",
    "lint": "biome lint ."
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@lima-garbage/email": "workspace:*",
    "better-auth": "~1.7.2",
    "hono": "^4.10.4",
    "pg": "^8.16.3",
    "resend": "^6.4.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/pg": "^8.15.6",
    "typescript": "5.9.3",
    "wrangler": "^4.46.0"
  }
}
