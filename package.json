{
  "name": "workspaces",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/database",
    "packages/email",
    "apps/*"
  ],
  "scripts": {
    "clean": "rm -rf node_modules packages/database/node_modules apps/citizen/node_modules bun.lock packages/database/bun.lock apps/citizen/bun.lock",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . && bun --filter @lima-garbage/citizens lint:eslint"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.2"
  },
  "resolutions": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "trustedDependencies": [
    "@lima-garbage/citizens",
    "esbuild",
    "sharp",
    "workerd"
  ]
}
