# Copy this file to .env and fill in the values.

# Get the connection string from the Supabase project dashboard:
# https://supabase.com/dashboard/project/[subdomain]
DATABASE_URL="postgresql://postgres.[subdomain]:[password]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres"

# Better Auth secret options:
# https://www.better-auth.com/docs/reference/options#secret
# https://www.better-auth.com/docs/installation#set-environment-variables
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:4000"

# Create a Resend API key here:
# https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="noreply@lima-limpia.pe"
EMAIL_FROM_NAME="Lima Limpia"
